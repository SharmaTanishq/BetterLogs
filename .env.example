# Local development defaults. Copy to .env (gitignored) and adjust if needed.
# Production values for Fly + Neon are managed via secrets, not this file.

# API → DB connection (matches infra/docker-compose.yml; port 5433 to avoid clashing with other local Postgres)
DATABASE_URL=postgresql://betterlog:betterlog@localhost:5433/betterlog

# API server
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# SDK → API connection (used by examples/wilco-order-demo)
BETTERLOG_API_URL=http://localhost:4000
BETTERLOG_API_KEY=blg_dev_localonly

# Diagnose agent — BYOK, runtime-selectable provider
# Pick one provider; the corresponding API key must be set below.
BETTERLOG_LLM_PROVIDER=openai
BETTERLOG_LLM_MODEL=gpt-5-mini
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
