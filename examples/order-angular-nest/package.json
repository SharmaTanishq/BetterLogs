{
  "name": "@betterlog/example-order-angular-nest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gateway": "tsx --env-file=../../.env gateway/src/main.ts",
    "inventory": "tsx --env-file=../../.env inventory/src/main.ts",
    "web": "vite --config web/vite.config.ts",
    "start": "concurrently -n gateway,inventory,web -c blue,green,magenta \"pnpm gateway\" \"pnpm inventory\" \"pnpm web\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@betterlog/sdk-browser": "workspace:*",
    "@betterlog/sdk-nestjs": "workspace:*",
    "@betterlog/sdk-node": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.14.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0",
    "vite": "^6.3.0"
  }
}
